# Render artifacts (qmd/Rmd/md -> html/pdf + supporting dirs). No .html is
# tracked in this repo, so these are safe to ignore repo-wide.
*.html
*_files/
.quarto/
/_site/

# Render outputs from smoke tests
r-quarto-jupyter/test/smoke_out.ipynb
r-quarto-jupyter/test/smoke_r_out.ipynb
r-quarto-jupyter/test/Rplots.pdf
tutorial/*.pdf

# PBS job output/error logs (argo-shim submit jobs land here when run in place)
*.o[0-9]*
*.e[0-9]*

# Backups created by the installer
*.bak.*

# Editor / OS junk
.DS_Store
*.swp
.ipynb_checkpoints/
__pycache__/
